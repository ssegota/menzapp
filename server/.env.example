GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
PORT=3000
# In production, set DATA_DIR to a mounted persistent volume (e.g. /data).
# Leave unset for local dev — data.json then lives next to index.js.
# DATA_DIR=/data

# Plaintext admin password. Read ONCE at server startup: if the admin user
# in data.json has no passwordHash yet, the server hashes this with scrypt
# (random per-user salt) and persists the hash. Can be removed from the
# environment after the first successful boot — the hash lives on the
# persistent volume from then on.
ADMIN_PASSWORD=Menza-admin
